# Copy this file to .env.local and fill in the values you need.
# You may omit GEMINI_API_KEY and provide it in the app's browser UI instead.
GEMINI_API_KEY=""

# Optional Google sign-in. Create a Web application OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Leave empty for local development at http://localhost:3000.
# In production, use the public HTTPS URL, without a trailing slash.
APP_BASE_URL=""
